name: Auto-merge player config PRs

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
    paths:
      - 'library/src/main/assets/player_configs.json'

jobs:
  auto-merge:
    if: |
      github.event.pull_request.user.login == 'cipher-bot[bot]' || 
      startsWith(github.event.pull_request.head.ref, 'auto-add-player-')
    runs-on: ubuntu-latest
    permissions:
      pull-requests: write
      contents: write
      statuses: read
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.head.ref }}
      
      - name: Wait for CI and enable auto-merge
        run: |
          # Wait for CI to pass (max 5 minutes)
          for i in {1..30}; do
            STATUS=$(gh api repos/${{ github.repository }}/commits/${{ github.event.pull_request.head.sha }}/status | jq -r '.state')
            echo "CI status: $STATUS (attempt $i/30)"
            
            if [ "$STATUS" = "success" ]; then
              echo "✅ CI passed! Enabling auto-merge..."
              gh pr merge ${{ github.event.pull_request.number }} --auto --merge --delete-branch
              echo "✅ Auto-merge enabled with branch deletion"
              exit 0
            elif [ "$STATUS" = "failure" ]; then
              echo "❌ CI failed! Not enabling auto-merge."
              exit 1
            fi
            sleep 10
          done
          
          echo "⏱️ Timeout waiting for CI status"
          exit 1
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      
      - name: Post success to Mattermost (optional)
        if: success()
        run: |
          curl -X POST -H 'Content-Type: application/json' \
            -d '{
              "text": "✅ **PR #${{ github.event.pull_request.number }} will auto-merge**\n- Config: `${{ github.event.pull_request.title }}`\n- URL: ${{ github.event.pull_request.html_url }}\n- Branch deletion enabled",
              "username": "Auto-Merge Bot"
            }' \
            ${{ secrets.MATTERMOST_WEBHOOK_URL }}
